{
  "schema_version": "1.0",
  "kind": "growovo.sop_version",
  "sop_id": "sop-devrel-first-success",
  "version": "1.0.0",
  "capability_id": "C18",
  "role_families": ["46", "09", "12", "24", "44"],
  "status": "design_example",
  "steps": [
    {
      "step_id": "confirm-task-and-value-event",
      "purpose": "固定开发者任务、合格主体和首次成功定义",
      "actor": {"type": "shared", "role_family": "46"},
      "inputs": ["approved_product_facts", "activation_event_definition"],
      "method": ["确认环境与前置条件", "排除下载、Star 等非价值事件", "确认结果数据源"],
      "tools": [{"kind": "read_only", "ref": "context_registry"}],
      "outputs": [{"deliverable_type": "developer_journey_card", "required": true}],
      "dod": [{"rule_id": "value-event-source-bound", "required": true}],
      "on_pass": "build-and-reproduce",
      "on_fail": "blocked_missing_value_event",
      "on_unknown": "human-review",
      "approval": {"required": true, "scope": "technical_value_event"}
    },
    {
      "step_id": "build-and-reproduce",
      "purpose": "制作教程并在干净环境真实复现",
      "actor": {"type": "shared", "role_family": "46"},
      "inputs": ["developer_journey_card"],
      "method": ["编写教程与最小示例", "固定版本", "运行复现命令", "保存输出与限制"],
      "tools": [{"kind": "read_only", "ref": "repository"}, {"kind": "draft", "ref": "artifact_studio"}],
      "outputs": [{"deliverable_type": "developer_tutorial", "required": true}],
      "dod": [{"rule_id": "clean-room-reproduction-passed", "required": true}, {"rule_id": "no-secrets", "required": true}],
      "on_pass": "prepare-distribution",
      "on_fail": "repair-tutorial",
      "on_unknown": "human-review",
      "approval": {"required": true, "scope": "technical_accuracy"}
    },
    {
      "step_id": "prepare-distribution",
      "purpose": "形成渠道原生发布包和互动处置方案",
      "actor": {"type": "agent", "role_family": "12"},
      "inputs": ["accepted_developer_tutorial", "channel_rules"],
      "method": ["按平台改写", "配置授权链接", "准备技术问答与升级条件"],
      "tools": [{"kind": "draft", "ref": "artifact_studio"}],
      "outputs": [{"deliverable_type": "distribution_and_followup_pack", "required": true}],
      "dod": [{"rule_id": "facts-preserved", "required": true}, {"rule_id": "interaction-owner-assigned", "required": true}],
      "on_pass": "authorize-execution",
      "on_fail": "repair-distribution-pack",
      "on_unknown": "human-review",
      "approval": {"required": false}
    },
    {
      "step_id": "authorize-execution",
      "purpose": "审批真实发布版本、账号和范围",
      "actor": {"type": "human", "role_family": "12"},
      "inputs": ["accepted_distribution_pack", "authorized_account", "execution_budget"],
      "method": ["预览真实载荷", "核对账号与平台规则", "批准或拒绝指定版本"],
      "tools": [{"kind": "action_request", "ref": "existing_approval_pipeline"}],
      "outputs": [{"deliverable_type": "execution_approval", "required": true}],
      "dod": [{"rule_id": "fingerprint-bound", "required": true}],
      "on_pass": "observe-interaction-and-activation",
      "on_fail": "return-to-prepare-distribution",
      "on_unknown": "human-review",
      "approval": {"required": true, "scope": "external_publish"}
    },
    {
      "step_id": "observe-interaction-and-activation",
      "purpose": "分层记录平台回执、技术互动和真实首次成功",
      "actor": {"type": "shared", "role_family": "24"},
      "inputs": ["ledger_refs", "interaction_records", "authorized_product_event_export"],
      "method": ["分开记录动作与任务", "回答或升级技术问题", "按指标字典核验激活"],
      "tools": [{"kind": "read_only", "ref": "result_projection"}],
      "outputs": [{"deliverable_type": "scoped_result_record", "required": true}],
      "dod": [{"rule_id": "three-layers-separated", "required": true}],
      "on_pass": "review-and-revise",
      "on_fail": "human-review",
      "on_unknown": "pending_maturity",
      "approval": {"required": false}
    },
    {
      "step_id": "review-and-revise",
      "purpose": "将观察转为有版本的规则变更或不改变决定",
      "actor": {"type": "human", "role_family": "44"},
      "inputs": ["scoped_result_record", "cost_record", "exceptions"],
      "method": ["区分事实与机制", "记录替代解释", "提出 SOP 或模板 diff", "指定下次验证"],
      "tools": [{"kind": "draft", "ref": "rule_change_registry"}],
      "outputs": [{"deliverable_type": "rule_change_decision", "required": true}],
      "dod": [{"rule_id": "decision-owner-and-version", "required": true}],
      "on_pass": "close",
      "on_fail": "collect-missing-evidence",
      "on_unknown": "inconclusive",
      "approval": {"required": true, "scope": "production_rule_change"}
    }
  ]
}
